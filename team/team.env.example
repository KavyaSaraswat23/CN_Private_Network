# Copy this file to team/team.env and fill in TODAY's real IP addresses.
# Wi-Fi IP addresses can change every time you reconnect (unless your
# router gives out static/reserved IPs) - re-check and update this file
# at the START of every work session, and re-share it with the team
# (e.g. paste updated values in your group chat) before configuring
# nginx or dnsmasq.
#
# Get your own IP by running: scripts/get-my-ip.sh

TEAM_DOMAIN=teamX.test

MAC1_IP=192.168.1.21    # DNS server
MAC2_IP=192.168.1.22    # nginx edge / load balancer
MAC3_IP=192.168.1.23    # Backend A
MAC4_IP=192.168.1.24    # Backend B
